{
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "800px",
            "wideSize": "1200px"
        },
        "color": {
            "palette": [
                {
                    "slug": "primary",
                    "color": "#2563eb",
                    "name": "Primary"
                },
                {
                    "slug": "secondary",
                    "color": "#4b5563",
                    "name": "Secondary"
                },
                {
                    "slug": "dark",
                    "color": "#111827",
                    "name": "Dark"
                },
                {
                    "slug": "light",
                    "color": "#f9fafb",
                    "name": "Light"
                }
            ]
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif",
                    "name": "System Sans-serif",
                    "slug": "system-sans"
                }
            ]
        }
    },
    "styles": {
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system-sans)",
            "lineHeight": "1.6"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                }
            }
        }
    }
}
